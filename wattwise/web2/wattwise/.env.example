# WattWise Environment Variables
# Copy this file to .env and fill in your own values

# Application
REACT_APP_NAME=WattWise
REACT_APP_VERSION=1.0.0

# API Configuration (untuk future development)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_WS_URL=ws://localhost:5000

# Authentication (untuk future development)
REACT_APP_JWT_SECRET=your_jwt_secret_here
REACT_APP_SESSION_TIMEOUT=3600

# IoT Configuration (untuk future development)
REACT_APP_IOT_ENABLED=true
REACT_APP_IOT_REFRESH_INTERVAL=5000
REACT_APP_ANOMALY_THRESHOLD=30

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_DARK_MODE=false
REACT_APP_ENABLE_MULTI_LANGUAGE=false

# Analytics (untuk future development)
REACT_APP_GA_ID=
REACT_APP_SENTRY_DSN=

# Development
PORT=3000
BROWSER=chrome
