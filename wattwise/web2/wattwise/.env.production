# WattWise Production Environment Variables

# Application
REACT_APP_NAME=WattWise
REACT_APP_VERSION=1.0.0

# API Configuration - Railway Backend (PRODUCTION)
# TODO: Update with your actual Railway backend URL after deployment
REACT_APP_API_URL=https://your-railway-app.up.railway.app/api
REACT_APP_WS_URL=wss://your-railway-app.up.railway.app

# Authentication
REACT_APP_JWT_SECRET=wattwise-secret-key-2025-production
REACT_APP_SESSION_TIMEOUT=3600

# IoT Configuration
REACT_APP_IOT_ENABLED=true
REACT_APP_IOT_REFRESH_INTERVAL=5000
REACT_APP_ANOMALY_THRESHOLD=30

# Feature Flags
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_MULTI_LANGUAGE=false

# Analytics (add your production analytics IDs)
REACT_APP_GA_ID=
REACT_APP_SENTRY_DSN=
